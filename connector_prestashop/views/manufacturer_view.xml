<odoo>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">product.brand.form.prestashop</field>
        <field name="model">product.brand</field>
        <field name="inherit_id" ref="product_brand.view_product_brand_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="prestashop_bindings" string="PrestaShop Bindings">
                    <field name="prestashop_bind_ids" nolabel="1">
                        <list>
                            <field name="backend_id" />
                            <field name="prestashop_id" />
                            <button name="resync" type="object" string="Resync" />
                        </list>
                        <form string="PrestaShop">
                            <group>
                                <field name="backend_id" />
                                <field name="prestashop_id" />
                                <field name="date_add" />
                                <field name="date_upd" />
                            </group>
                            <button name="resync" type="object" string="Resync" class="oe_highlight" />
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_prestashop_manufacturer_form" model="ir.ui.view">
        <field name="name">prestashop.manufacturer.form</field>
        <field name="model">prestashop.manufacturer</field>
        <field name="arch" type="xml">
            <form string="PrestaShop Manufacturer">
                <group name="binding" string="Binding">
                    <field name="backend_id" />
                    <field name="prestashop_id" />
                </group>
                <group name="information" string="Information">
                    <field name="name" />
                    <field name="date_add" />
                    <field name="date_upd" />
                </group>
                <button name="resync" type="object" string="Resync" class="oe_highlight" />
            </form>
        </field>
    </record>

    <record id="view_prestashop_manufacturer_tree" model="ir.ui.view">
        <field name="name">prestashop.manufacturer.list</field>
        <field name="model">prestashop.manufacturer</field>
        <field name="arch" type="xml">
            <list>
                <field name="backend_id" />
                <field name="prestashop_id" />
                <field name="name" />
                <button name="resync" type="object" string="Resync" />
            </list>
        </field>
    </record>

</odoo>
